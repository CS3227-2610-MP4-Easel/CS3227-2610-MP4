{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Read|Write|Edit|Grep|Glob|Search|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-pre-tool-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
